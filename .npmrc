# warden is a standalone, publishable package. Its only peer (@c9up/ream) is
# optional and provided by the host application — it must NOT be auto-fetched
# during a standalone `pnpm install` (it isn't on npm during local dev, and
# warden's own tests never import it). pnpm's default auto-install-peers=true
# would otherwise try to resolve it and fail with ERR_PNPM_FETCH_404.
auto-install-peers=false
