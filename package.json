{
  "name": "@c9up/warden",
  "version": "0.1.14",
  "description": "Warden — Authentication & authorization for the Ream framework",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "index.*.node",
    "scripts",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./provider": {
      "types": "./src/WardenProvider.ts",
      "import": "./src/WardenProvider.ts"
    },
    "./services/main": {
      "types": "./src/services/main.ts",
      "import": "./src/services/main.ts"
    },
    "./middleware": {
      "types": "./src/middleware.ts",
      "import": "./src/middleware.ts"
    },
    "./silent-auth": {
      "types": "./src/silent-auth.ts",
      "import": "./src/silent-auth.ts"
    },
    "./config": {
      "types": "./src/config.ts",
      "import": "./src/config.ts"
    },
    "./standalone": {
      "types": "./src/standalone.ts",
      "import": "./src/standalone.ts"
    },
    "./configure": {
      "types": "./src/configure.ts",
      "import": "./src/configure.ts"
    }
  },
  "peerDependencies": {
    "@c9up/ream": "^0.1.10"
  },
  "peerDependenciesMeta": {
    "@c9up/ream": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:rust": "cargo build --release -p warden-engine-napi",
    "build:napi": "pnpm build:rust && node scripts/copy-napi.mjs",
    "test": "vitest run",
    "test:rust": "cargo test -p warden-engine",
    "lint": "biome check src/",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@types/node": "^22.19.15",
    "reflect-metadata": "^0.2.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "pnpm": {
    "//": "Pin the test toolchain to the versions used in dev. Without a committed lockfile the standalone CI resolves fresh (esbuild 0.28.x / vitest 4.1.9), whose decorator transform flakes 'Invalid or unexpected token' on the @Guard/@Permission/@Role suites. Overrides only apply when this package is the install root (CI), so the monorepo workspace is unaffected.",
    "overrides": {
      "esbuild": "0.27.7",
      "vite": "7.3.3",
      "vitest": "4.1.6"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./provider": {
        "types": "./dist/WardenProvider.d.ts",
        "import": "./dist/WardenProvider.js"
      },
      "./services/main": {
        "types": "./dist/services/main.d.ts",
        "import": "./dist/services/main.js"
      },
      "./middleware": {
        "types": "./dist/middleware.d.ts",
        "import": "./dist/middleware.js"
      },
      "./silent-auth": {
        "types": "./dist/silent-auth.d.ts",
        "import": "./dist/silent-auth.js"
      },
      "./config": {
        "types": "./dist/config.d.ts",
        "import": "./dist/config.js"
      },
      "./standalone": {
        "types": "./dist/standalone.d.ts",
        "import": "./dist/standalone.js"
      },
      "./configure": {
        "types": "./dist/configure.d.ts",
        "import": "./dist/configure.js"
      }
    },
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/C9up/warden.git"
  }
}
